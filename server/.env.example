# MongoDB
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/pawmira?retryWrites=true&w=majority

# JWT
JWT_SECRET=your_jwt_secret_here_change_in_production

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Twilio (WhatsApp)
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Twilio WhatsApp webhook (public URL where Twilio posts incoming messages)
WHATSAPP_WEBHOOK_URL=https://your-deployed-domain/api/whatsapp

# Email (Nodemailer transport — use a Gmail App Password, NOT your regular Gmail password)
EMAIL_USER=your_gmail_address_here
EMAIL_PASS=your_gmail_app_password_here

# Brevo (transactional email — used when BREVO_API_KEY is set; falls back to Nodemailer/Gmail)
BREVO_API_KEY=your_brevo_api_key_here
BREVO_FROM_EMAIL=your_verified_sender_email_here

# Message encryption key (REQUIRED — must be a 64-character hex string representing a 256-bit key for aes-256-cbc)
# Generate a true 256-bit secure key with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_64_character_hex_string_here_for_true_256_bit_security

# Server
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS and password-reset links)
CLIENT_URL=http://localhost:5173

# Gemini API (for AI image validation — used in report creation)
GEMINI_API_KEY=your_gemini_api_key_here
